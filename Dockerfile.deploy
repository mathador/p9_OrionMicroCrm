# Dockerfile pour deployment avec artifacts pré-compilés
# Utilisé uniquement dans le pipeline CI/CD après tests et builds réussis
# Garantit que le code testé est exactement ce qui est déployé

FROM caddy:2-alpine AS caddy-stage

FROM eclipse-temurin:17-jre-jammy AS runtime

# Copier Caddy depuis l'image officielle (plus fiable que l'installation manuelle)
COPY --from=caddy-stage /usr/bin/caddy /usr/bin/caddy

# Création des répertoires de travail
WORKDIR /app

# Copie des artifacts pré-compilés depuis le contexte de build
# Ces fichiers sont téléchargés depuis les artifacts du workflow CI/CD
COPY backend.jar /app/backend.jar
COPY frontend-dist/ /app/front

# Configuration Caddy pour servir le frontend et proxy vers le backend
COPY front/Caddyfile /etc/caddy/Caddyfile

# Exposition des ports
EXPOSE 80 443 8080

# Demarrage des deux processus sans supervisor (evite apt/dpkg en build arm64)
CMD ["sh", "-c", "java -jar /app/backend.jar & exec caddy run --config /etc/caddy/Caddyfile"]

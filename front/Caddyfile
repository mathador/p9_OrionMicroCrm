* {
	encode gzip

	# Les routes API doivent passer AVANT le fallback SPA, sinon index.html est servi.
	@api path /organizations* /persons*
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}

	# Frontend Angular (fallback sur index.html pour le routing client)
	handle {
		root * /app/front
		try_files {path} /index.html
		file_server
	}
}
